# Copy thanh .env va DOI HET gia tri truoc khi deploy that.
DB_PASSWORD=change-this-db-password
S3_ACCESS_KEY=nimbus
S3_SECRET_KEY=change-this-s3-secret
S3_BUCKET=nimbus-files
# Endpoint ma trinh duyet thay duoc (cho presigned URL)
S3_PUBLIC_ENDPOINT=http://localhost:8333
# Toi thieu 32 ky tu ngau nhien:  openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
DEFAULT_QUOTA_BYTES=1073741824
APP_PORT=8080
# --profile proxy
DOMAIN=localhost
# --profile monitoring
GRAFANA_PASSWORD=admin
